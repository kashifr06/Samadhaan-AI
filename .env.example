# Demo Mode
# Set to true only for local/Hacknova demo role switching.
# Production must keep both values false.
VITE_DEMO_MODE=false
DEMO_MODE=false

# Firebase Frontend Configuration
# These are required to initialize the Firebase client SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin Configuration
# Explicit service-account credentials are supported when all three values are set.
# If client email/private key are omitted, Application Default Credentials are used.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Gemini API
# Required for server-side AI analysis of submitted problems
GEMINI_API_KEY=
