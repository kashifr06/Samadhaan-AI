# Server Mode
# Set to true for local testing or Hackathon demos where Firebase Auth is bypassed.
# Set to false for Production.
VITE_DEMO_MODE=true
DEMO_MODE=true

# Firebase Frontend Configuration
# These are required to initialize the Firebase client SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=cortex-856a1
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin Configuration
# Used by the backend to securely interact with Firestore
FIREBASE_PROJECT_ID=cortex-856a1
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Gemini API
# Required for server-side AI analysis of submitted problems
GEMINI_API_KEY=
